{
  "manifest_version": 1,
  "type": "device",
  "name": "Heatzy",
  "description": {
    "en": "Heatzy pilot wire modules: mode of each radiator, vacation, widget and scenes.",
    "fr": "Modules fil pilote Heatzy : mode de chaque radiateur, vacances, widget et scènes.",
    "de": "Heatzy-Steuerdrahtmodule: Modus jedes Heizkörpers, Urlaub, Widget und Szenen.",
    "es": "Módulos de hilo piloto Heatzy: modo de cada radiador, vacaciones, widget y escenas."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-heatzy:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-heatzy/main/cover.png",
  "categories": ["climate"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your Heatzy account",
        "fr": "Votre compte Heatzy",
        "de": "Dein Heatzy-Konto",
        "es": "Su cuenta Heatzy"
      },
      "description": {
        "en": "The account of the Heatzy app: every module of the account becomes a device in the Discovery tab. The integration reads the Heatzy cloud: an Internet connection is required.",
        "fr": "Le compte de l'application Heatzy : chaque module du compte devient un appareil dans l'onglet Découverte. L'intégration lit le cloud Heatzy : une connexion Internet est nécessaire.",
        "de": "Das Konto der Heatzy-App: Jedes Modul des Kontos wird zu einem Gerät im Tab Erkennung. Die Integration liest die Heatzy-Cloud: Eine Internetverbindung ist nötig.",
        "es": "La cuenta de la aplicación Heatzy: cada módulo de la cuenta se convierte en un dispositivo en la pestaña Descubrimiento. La integración lee la nube de Heatzy: se necesita conexión a Internet."
      }
    },
    {
      "key": "email",
      "type": "string",
      "label": {
        "en": "E-mail address",
        "fr": "Adresse e-mail",
        "de": "E-Mail-Adresse",
        "es": "Dirección de correo"
      },
      "description": {
        "en": "The one you use to sign in to the Heatzy app.",
        "fr": "Celle qui sert à vous connecter à l'application Heatzy.",
        "de": "Die, mit der du dich in der Heatzy-App anmeldest.",
        "es": "La que utiliza para iniciar sesión en la aplicación Heatzy."
      },
      "placeholder": {
        "en": "e.g. name@example.com",
        "fr": "ex. nom@example.com",
        "de": "z. B. name@example.com",
        "es": "p. ej. nombre@example.com"
      },
      "required": true,
      "default": ""
    },
    {
      "key": "password",
      "type": "secret",
      "label": {
        "en": "Password",
        "fr": "Mot de passe",
        "de": "Passwort",
        "es": "Contraseña"
      },
      "description": {
        "en": "The password of the Heatzy app. It stays in Gladys and is only sent to the Heatzy cloud.",
        "fr": "Le mot de passe de l'application Heatzy. Il reste dans Gladys et n'est envoyé qu'au cloud Heatzy.",
        "de": "Das Passwort der Heatzy-App. Es bleibt in Gladys und wird nur an die Heatzy-Cloud gesendet.",
        "es": "La contraseña de la aplicación Heatzy. Se queda en Gladys y solo se envía a la nube de Heatzy."
      },
      "required": true
    },
    {
      "key": "poll_interval",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Intervalle de rafraîchissement",
        "de": "Aktualisierungsintervall",
        "es": "Intervalo de actualización"
      },
      "description": {
        "en": "How often the modules are read. A change made from Gladys shows at once.",
        "fr": "Fréquence de lecture des modules. Un changement fait depuis Gladys s'affiche tout de suite.",
        "de": "Wie oft die Module gelesen werden. Eine Änderung über Gladys erscheint sofort.",
        "es": "Frecuencia de lectura de los módulos. Un cambio hecho desde Gladys se muestra al instante."
      },
      "options": [
        {
          "value": "60",
          "label": {
            "en": "1 minute",
            "fr": "1 minute",
            "de": "1 Minute",
            "es": "1 minuto"
          }
        },
        {
          "value": "120",
          "label": {
            "en": "2 minutes",
            "fr": "2 minutes",
            "de": "2 Minuten",
            "es": "2 minutos"
          }
        },
        {
          "value": "300",
          "label": {
            "en": "5 minutes",
            "fr": "5 minutes",
            "de": "5 Minuten",
            "es": "5 minutos"
          }
        },
        {
          "value": "600",
          "label": {
            "en": "10 minutes",
            "fr": "10 minutes",
            "de": "10 Minuten",
            "es": "10 minutos"
          }
        }
      ],
      "default": "120"
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the names",
        "fr": "Langue des noms",
        "de": "Sprache der Namen",
        "es": "Idioma de los nombres"
      },
      "description": {
        "en": "Language of the feature names and of the messages of the integration.",
        "fr": "Langue des noms de fonctionnalités et des messages de l'intégration.",
        "de": "Sprache der Funktionsnamen und der Meldungen der Integration.",
        "es": "Idioma de los nombres de las funciones y de los mensajes de la integración."
      },
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ],
      "default": "fr"
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "description": {
        "en": "Signs in to Heatzy now and lists the modules of the account.",
        "fr": "Se connecte à Heatzy maintenant et liste les modules du compte.",
        "de": "Meldet sich jetzt bei Heatzy an und listet die Module des Kontos auf.",
        "es": "Inicia sesión en Heatzy ahora y enumera los módulos de la cuenta."
      },
      "timeout_seconds": 60
    }
  ],
  "scene_triggers": [
    {
      "key": "mode_changed",
      "label": {
        "en": "Radiator mode changed outside Gladys",
        "fr": "Mode d'un radiateur changé hors de Gladys",
        "de": "Heizkörpermodus außerhalb von Gladys geändert",
        "es": "Modo de un radiador cambiado fuera de Gladys"
      },
      "description": {
        "en": "The Heatzy app, the weekly programme or a button changed the mode of a radiator. Changes made by Gladys are not announced.",
        "fr": "L'application Heatzy, la programmation ou un bouton a changé le mode d'un radiateur. Les changements faits par Gladys ne sont pas annoncés.",
        "de": "Die Heatzy-App, das Wochenprogramm oder eine Taste hat den Modus eines Heizkörpers geändert. Änderungen durch Gladys werden nicht gemeldet.",
        "es": "La aplicación Heatzy, la programación o un botón ha cambiado el modo de un radiador. Los cambios hechos por Gladys no se anuncian."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Radiator (empty: any)",
            "fr": "Radiateur (vide : n'importe lequel)",
            "de": "Heizkörper (leer: beliebig)",
            "es": "Radiador (vacío: cualquiera)"
          }
        },
        {
          "key": "mode",
          "type": "select",
          "label": {
            "en": "New mode (empty: any)",
            "fr": "Nouveau mode (vide : tous)",
            "de": "Neuer Modus (leer: beliebig)",
            "es": "Nuevo modo (vacío: cualquiera)"
          },
          "options": [
            {
              "value": "comfort",
              "label": {
                "en": "Comfort",
                "fr": "Confort",
                "de": "Komfort",
                "es": "Confort"
              }
            },
            {
              "value": "comfort_1",
              "label": {
                "en": "Comfort -1°C",
                "fr": "Confort -1°C",
                "de": "Komfort -1°C",
                "es": "Confort -1°C"
              }
            },
            {
              "value": "comfort_2",
              "label": {
                "en": "Comfort -2°C",
                "fr": "Confort -2°C",
                "de": "Komfort -2°C",
                "es": "Confort -2°C"
              }
            },
            {
              "value": "eco",
              "label": {
                "en": "Eco",
                "fr": "Eco",
                "de": "Öko",
                "es": "Eco"
              }
            },
            {
              "value": "frost_protection",
              "label": {
                "en": "Frost protection",
                "fr": "Hors gel",
                "de": "Frostschutz",
                "es": "Antihielo"
              }
            },
            {
              "value": "off",
              "label": {
                "en": "Off",
                "fr": "Off",
                "de": "Aus",
                "es": "Apagado"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "radiator",
          "type": "string",
          "label": {
            "en": "Radiator name",
            "fr": "Nom du radiateur",
            "de": "Name des Heizkörpers",
            "es": "Nombre del radiador"
          }
        },
        {
          "key": "device",
          "type": "string",
          "label": {
            "en": "Radiator device",
            "fr": "Appareil radiateur",
            "de": "Heizkörper-Gerät",
            "es": "Dispositivo del radiador"
          }
        },
        {
          "key": "mode",
          "type": "string",
          "label": {
            "en": "New mode (comfort, eco…)",
            "fr": "Nouveau mode (comfort, eco…)",
            "de": "Neuer Modus (comfort, eco…)",
            "es": "Nuevo modo (comfort, eco…)"
          }
        },
        {
          "key": "previous_mode",
          "type": "string",
          "label": {
            "en": "Previous mode",
            "fr": "Mode précédent",
            "de": "Vorheriger Modus",
            "es": "Modo anterior"
          }
        },
        {
          "key": "programming",
          "type": "boolean",
          "label": {
            "en": "Weekly programme on",
            "fr": "Programmation active",
            "de": "Wochenprogramm aktiv",
            "es": "Programación activa"
          }
        }
      ]
    },
    {
      "key": "module_offline",
      "label": {
        "en": "Heatzy module offline",
        "fr": "Module Heatzy hors ligne",
        "de": "Heatzy-Modul offline",
        "es": "Módulo Heatzy desconectado"
      },
      "description": {
        "en": "A module lost its connection to the Heatzy cloud (Wi-Fi, power cut): it can no longer be controlled.",
        "fr": "Un module a perdu sa connexion au cloud Heatzy (Wi-Fi, coupure de courant) : il ne peut plus être piloté.",
        "de": "Ein Modul hat die Verbindung zur Heatzy-Cloud verloren (WLAN, Stromausfall): Es lässt sich nicht mehr steuern.",
        "es": "Un módulo ha perdido la conexión con la nube de Heatzy (wifi, corte de luz): ya no se puede controlar."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Radiator (empty: any)",
            "fr": "Radiateur (vide : n'importe lequel)",
            "de": "Heizkörper (leer: beliebig)",
            "es": "Radiador (vacío: cualquiera)"
          }
        }
      ],
      "variables": [
        {
          "key": "radiator",
          "type": "string",
          "label": {
            "en": "Radiator name",
            "fr": "Nom du radiateur",
            "de": "Name des Heizkörpers",
            "es": "Nombre del radiador"
          }
        },
        {
          "key": "device",
          "type": "string",
          "label": {
            "en": "Radiator device",
            "fr": "Appareil radiateur",
            "de": "Heizkörper-Gerät",
            "es": "Dispositivo del radiador"
          }
        }
      ]
    },
    {
      "key": "module_online",
      "label": {
        "en": "Heatzy module back online",
        "fr": "Module Heatzy de retour en ligne",
        "de": "Heatzy-Modul wieder online",
        "es": "Módulo Heatzy conectado de nuevo"
      },
      "description": {
        "en": "A module that was offline is connected to the Heatzy cloud again.",
        "fr": "Un module hors ligne est de nouveau connecté au cloud Heatzy.",
        "de": "Ein Modul, das offline war, ist wieder mit der Heatzy-Cloud verbunden.",
        "es": "Un módulo que estaba desconectado vuelve a estar conectado a la nube de Heatzy."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Radiator (empty: any)",
            "fr": "Radiateur (vide : n'importe lequel)",
            "de": "Heizkörper (leer: beliebig)",
            "es": "Radiador (vacío: cualquiera)"
          }
        }
      ],
      "variables": [
        {
          "key": "radiator",
          "type": "string",
          "label": {
            "en": "Radiator name",
            "fr": "Nom du radiateur",
            "de": "Name des Heizkörpers",
            "es": "Nombre del radiador"
          }
        },
        {
          "key": "device",
          "type": "string",
          "label": {
            "en": "Radiator device",
            "fr": "Appareil radiateur",
            "de": "Heizkörper-Gerät",
            "es": "Dispositivo del radiador"
          }
        }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "set_mode",
      "label": {
        "en": "Set the mode of Heatzy radiators",
        "fr": "Mettre des radiateurs Heatzy dans un mode",
        "de": "Modus von Heatzy-Heizkörpern setzen",
        "es": "Poner radiadores Heatzy en un modo"
      },
      "description": {
        "en": "One radiator or all of them. A vacation in progress is ended. Comfort -1 and -2 are skipped on the modules without them.",
        "fr": "Un radiateur ou tous. Des vacances en cours sont arrêtées. Confort -1 et -2 sont ignorés par les modules qui ne les ont pas.",
        "de": "Ein Heizkörper oder alle. Ein laufender Urlaub wird beendet. Komfort -1 und -2 werden bei Modulen ohne diese Modi übersprungen.",
        "es": "Un radiador o todos. Unas vacaciones en curso se terminan. Confort -1 y -2 se omiten en los módulos que no los tienen."
      },
      "timeout_seconds": 60,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Radiator (empty: all)",
            "fr": "Radiateur (vide : tous)",
            "de": "Heizkörper (leer: alle)",
            "es": "Radiador (vacío: todos)"
          }
        },
        {
          "key": "mode",
          "type": "select",
          "required": true,
          "label": {
            "en": "Mode",
            "fr": "Mode",
            "de": "Modus",
            "es": "Modo"
          },
          "options": [
            {
              "value": "comfort",
              "label": {
                "en": "Comfort",
                "fr": "Confort",
                "de": "Komfort",
                "es": "Confort"
              }
            },
            {
              "value": "comfort_1",
              "label": {
                "en": "Comfort -1°C",
                "fr": "Confort -1°C",
                "de": "Komfort -1°C",
                "es": "Confort -1°C"
              }
            },
            {
              "value": "comfort_2",
              "label": {
                "en": "Comfort -2°C",
                "fr": "Confort -2°C",
                "de": "Komfort -2°C",
                "es": "Confort -2°C"
              }
            },
            {
              "value": "eco",
              "label": {
                "en": "Eco",
                "fr": "Eco",
                "de": "Öko",
                "es": "Eco"
              }
            },
            {
              "value": "frost_protection",
              "label": {
                "en": "Frost protection",
                "fr": "Hors gel",
                "de": "Frostschutz",
                "es": "Antihielo"
              }
            },
            {
              "value": "off",
              "label": {
                "en": "Off",
                "fr": "Off",
                "de": "Aus",
                "es": "Apagado"
              }
            }
          ]
        }
      ],
      "outputs": [
        {
          "key": "count",
          "type": "number",
          "label": {
            "en": "Modules that accepted",
            "fr": "Modules ayant accepté",
            "de": "Module, die angenommen haben",
            "es": "Módulos que han aceptado"
          }
        }
      ]
    },
    {
      "key": "start_vacation",
      "label": {
        "en": "Start the Heatzy vacation mode",
        "fr": "Démarrer le mode vacances Heatzy",
        "de": "Heatzy-Urlaubsmodus starten",
        "es": "Iniciar el modo vacaciones de Heatzy"
      },
      "description": {
        "en": "Frost protection for a number of days, then the module returns to its programme. Not on the Pilote v1.",
        "fr": "Hors gel pendant un nombre de jours, puis le module reprend sa programmation. Pas sur le Pilote v1.",
        "de": "Frostschutz für eine Anzahl von Tagen, danach kehrt das Modul zu seinem Programm zurück. Nicht beim Pilote v1.",
        "es": "Antihielo durante un número de días; después el módulo vuelve a su programación. No en el Pilote v1."
      },
      "timeout_seconds": 60,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Radiator (empty: all)",
            "fr": "Radiateur (vide : tous)",
            "de": "Heizkörper (leer: alle)",
            "es": "Radiador (vacío: todos)"
          }
        },
        {
          "key": "days",
          "type": "number",
          "required": true,
          "min": 1,
          "max": 255,
          "default": 7,
          "label": {
            "en": "Days",
            "fr": "Jours",
            "de": "Tage",
            "es": "Días"
          }
        }
      ],
      "outputs": [
        {
          "key": "count",
          "type": "number",
          "label": {
            "en": "Modules that accepted",
            "fr": "Modules ayant accepté",
            "de": "Module, die angenommen haben",
            "es": "Módulos que han aceptado"
          }
        }
      ]
    },
    {
      "key": "stop_vacation",
      "label": {
        "en": "End the Heatzy vacation mode",
        "fr": "Arrêter le mode vacances Heatzy",
        "de": "Heatzy-Urlaubsmodus beenden",
        "es": "Terminar el modo vacaciones de Heatzy"
      },
      "description": {
        "en": "Ends the vacation (or a boost) in progress: the module returns to its mode or programme.",
        "fr": "Arrête les vacances (ou un boost) en cours : le module reprend son mode ou sa programmation.",
        "de": "Beendet den laufenden Urlaub (oder einen Boost): Das Modul kehrt zu seinem Modus oder Programm zurück.",
        "es": "Termina las vacaciones (o un boost) en curso: el módulo vuelve a su modo o programación."
      },
      "timeout_seconds": 60,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Radiator (empty: all)",
            "fr": "Radiateur (vide : tous)",
            "de": "Heizkörper (leer: alle)",
            "es": "Radiador (vacío: todos)"
          }
        }
      ],
      "outputs": [
        {
          "key": "count",
          "type": "number",
          "label": {
            "en": "Modules that accepted",
            "fr": "Modules ayant accepté",
            "de": "Module, die angenommen haben",
            "es": "Módulos que han aceptado"
          }
        }
      ]
    }
  ],
  "widgets": [
    {
      "key": "radiators",
      "label": {
        "en": "Heatzy radiators",
        "fr": "Radiateurs Heatzy",
        "de": "Heatzy-Heizkörper",
        "es": "Radiadores Heatzy"
      },
      "description": {
        "en": "Mode of each radiator, with Comfort, Eco, Frost protection and Off buttons.",
        "fr": "Mode de chaque radiateur, avec boutons Confort, Eco, Hors gel et Off.",
        "de": "Modus jedes Heizkörpers, mit Tasten Komfort, Öko, Frostschutz und Aus.",
        "es": "Modo de cada radiador, con botones Confort, Eco, Antihielo y Apagado."
      },
      "icon": "thermometer",
      "settings": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Radiator (empty: all)",
            "fr": "Radiateur (vide : tous)",
            "de": "Heizkörper (leer: alle)",
            "es": "Radiador (vacío: todos)"
          }
        }
      ],
      "action_timeout_seconds": 60
    }
  ]
}
